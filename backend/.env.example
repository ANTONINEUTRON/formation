# Port the API listens on. Read directly by main.ts.
PORT=3000

# Postgres. Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formation_dev
# Tests only — never needed on a deployed server.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formation_test

# Solana RPC. The public endpoint rate-limits, and every tick reads balances
# per player, so use a Helius (or similar) key in anything but local dev.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
JUPITER_API_URL=https://lite-api.jup.ag

# Revenue: the fee on every swap, taken inside the transaction the player
# signs. JUPITER_FEE_ACCOUNT must be a USDC *token account* you control, not a
# wallet address. Leave it empty to disable fees — Jupiter rejects a fee
# without an account, so it is both or neither.
PLATFORM_FEE_BPS=30
JUPITER_FEE_ACCOUNT=

# Signs app bearer tokens. Use 32+ random bytes, never anything derived from a
# public value: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Required as the x-admin-key header for /admin/*.
ADMIN_KEY=

# Scoring (docs/formation-scoring.md).
# PRICE_TICK_MINUTES is how often prices are recorded AND points are banked —
# the general league has no window to wait for, so this is the heartbeat.
PRICE_TICK_MINUTES=5
# A "session" is the window role events (goals, buckets, touchdowns) roll up
# over. Sessions tile forward from SESSION_ANCHOR, so every player shares them.
SESSION_MINUTES=1440
SESSION_ANCHOR=2026-01-05T00:00:00.000Z
# SPYx: every pick is scored on how far it beat this.
BENCHMARK_MINT=XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W
