# Port the API listens on. Read directly by main.ts.
PORT=3000

# Postgres. Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formation_dev
# Tests only — never needed on a deployed server.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formation_test

# Solana RPC. The public endpoint rate-limits, and every tick reads balances
# per player, so use a Helius (or similar) key in anything but local dev.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# Jupiter serves prices AND swap quotes, so it is on the path of both the
# scoring tick and every buy. Get a key at https://developers.jup.ag/portal.
#
# Leave JUPITER_API_URL unset and the host follows the key: api.jup.ag when a
# key is present, lite-api.jup.ag when it is not. Setting both by hand is the
# one way to get this wrong — a key sent to lite-api.jup.ag is ignored, and you
# stay on the keyless limit while believing you are not.
JUPITER_API_KEY=
# JUPITER_API_URL=

# Revenue: the fee on every swap, taken inside the transaction the player
# signs.
#
# Jupiter requires the fee account's mint to match the swap's input or output,
# so each payable token needs its own *token account* — NOT a wallet address.
# Putting a wallet address here does not merely lose the fee, it makes Jupiter
# reject the swap, so that token stops working entirely. A token left blank is
# safe: it swaps normally and just earns nothing.
#
# For SOL the account must be a *wrapped* SOL token account (mint So111…112),
# which most wallets do not create for you:
#   spl-token create-account So11111111111111111111111111111111111111112
# Check any value here before trusting it:
#   solana account <ADDRESS>   # must be owned by the SPL Token program
PLATFORM_FEE_BPS=30
JUPITER_FEE_ACCOUNT_USDC=
JUPITER_FEE_ACCOUNT_SOL=
JUPITER_FEE_ACCOUNT_SKR=

# Players pay with USDC or SOL out of the box. SKR is offered only once its
# mint is set here — better than shipping a placeholder address.
#
# SKR_DECIMALS must match the mint exactly. It is the scale applied to the
# amount a player types, so being one order out overspends their wallet by that
# factor. Read it off the mint rather than assuming the usual 9:
#   spl-token display <SKR_MINT>
SKR_MINT=
SKR_DECIMALS=6

# Signs app bearer tokens. Use 32+ random bytes, never anything derived from a
# public value: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Required as the x-admin-key header for /admin/*.
ADMIN_KEY=

# Scoring (docs/formation-scoring.md).
# PRICE_TICK_MINUTES is how often prices are recorded AND points are banked —
# the general league has no window to wait for, so this is the heartbeat.
PRICE_TICK_MINUTES=5
# A "session" is the window role events (goals, buckets, touchdowns) roll up
# over. Sessions tile forward from SESSION_ANCHOR, so every player shares them.
SESSION_MINUTES=1440
SESSION_ANCHOR=2026-01-05T00:00:00.000Z
# SPYx: every pick is scored on how far it beat this.
BENCHMARK_MINT=XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W
