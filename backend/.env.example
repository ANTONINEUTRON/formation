PORT=3000

# Postgres. Local development:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formation_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/formation_test
# Supabase later (Project settings → Database → Connection string):
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require

# Solana RPC. The public endpoint rate-limits price ticks; use a Helius key.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
JUPITER_API_URL=https://lite-api.jup.ag

# Revenue: fee on every draft swap. JUPITER_FEE_ACCOUNT is a USDC token account
# you control. Leave it empty to disable fees (Jupiter rejects a fee without one).
PLATFORM_FEE_BPS=30
JUPITER_FEE_ACCOUNT=

# Base58 secret key of a funded wallet that writes trophy memo transactions.
# Leave empty to store trophies without an on-chain memo.
TROPHY_SECRET_KEY=

# Signs app bearer tokens. Any long random string.
AUTH_SECRET=

# Required as the x-admin-key header for /admin/* (tick, advance, settle).
ADMIN_KEY=

# Scoring cadence (docs/formation-scoring.md). Defaults shown; the demo profile
# in .env.demo shortens them so a gameweek can open and close on stage.
PRICE_TICK_MINUTES=60
GAMEWEEK_MINUTES_FOOTBALL=10080
GAMEWEEK_MINUTES_BASKETBALL=1440
GAMEWEEK_MINUTES_AMERICAN_FOOTBALL=10080
SESSION_MINUTES=1440
GAMEWEEK_ANCHOR=2026-01-05T00:00:00.000Z
# SPYx: every pick is scored against this benchmark.
BENCHMARK_MINT=XsoCS1TfEyfFhfvj8EtZ528L3CaKBDBRqRapnBbDF2W
