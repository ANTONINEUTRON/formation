PORT=3000

# Supabase (service role key; the app never talks to Supabase directly)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Solana RPC. The public endpoint rate-limits the hourly tick; use a Helius key.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
JUPITER_API_URL=https://lite-api.jup.ag

# Revenue: fee on every draft swap. JUPITER_FEE_ACCOUNT is a USDC token account
# you control. Leave it empty to disable fees (Jupiter rejects a fee without one).
PLATFORM_FEE_BPS=30
JUPITER_FEE_ACCOUNT=

# Base58 secret key of a funded wallet that writes trophy memo transactions.
# Leave empty to store trophies without an on-chain memo.
TROPHY_SECRET_KEY=

# Signs app bearer tokens. Any long random string.
AUTH_SECRET=

# Required as the x-admin-key header for /admin/tick and /admin/duels/:id/settle.
ADMIN_KEY=
