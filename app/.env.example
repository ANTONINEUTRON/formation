# Build-time configuration for the Flutter app.
#
# Copy to `.env`, fill in, then regenerate the Env class:
#   dart run build_runner build --delete-conflicting-outputs
#
# `.env` and the generated `lib/env/env.g.dart` are both untracked, because
# they hold whatever you put here verbatim. Every value has a default in
# lib/env/env.dart, so a missing `.env` still builds — against the public
# endpoints, which is fine for a smoke test and not for players.

# NestJS backend. Leave empty to run on in-memory fixtures with no backend.
API_URL=https://api.formation.titalabs.xyz

# Solana RPC. The public endpoint rate-limits per origin and the web build
# reaches that far sooner than the APK does, since every balance read goes
# through it. Use a dedicated endpoint (Helius or similar) for the web app.
#
# This is NOT a secret in a web build: the bundle ships to the browser, so
# anyone can read the key out of it. Restrict it by domain at the provider —
# that is the control that actually holds.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Must be the same provider as SOLANA_RPC_URL.
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
