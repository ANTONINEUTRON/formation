{
  "name": "formation-web-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "Wallet Standard bridge exposed to the Flutter web build as window.formationWallet",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=iife --target=es2020 --minify --outfile=../web/wallet_bridge.js",
    "dev": "esbuild src/index.ts --bundle --format=iife --target=es2020 --sourcemap --watch --outfile=../web/wallet_bridge.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana-mobile/wallet-standard-mobile": "^0.4.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "@wallet-standard/features": "^1.1.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
